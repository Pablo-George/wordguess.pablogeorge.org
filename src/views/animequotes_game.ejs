<%- include('header') %>
<div class="animequotes-page">

  <h1>Anime Quote</h1>
  <p class="puzzle-date"><%= game.anime_name %> &nbsp;·&nbsp; Game #<%= game.id %></p>

  <%# ── WAITING ──────────────────────────────────── %>
  <% if (game.status === 'waiting') { %>

    <section class="dash-section" id="lobby-section" data-game-type="animequotes" data-game-id="<%= game.id %>" data-created-by="<%= game.created_by %>">
      <h2>Lobby</h2>

      <div class="member-list" style="margin:1.5rem 0">
        <% players.forEach(function(p) { %>
          <div class="member-card">
            <img src="<%= p.avatar_url || '' %>" alt="" class="member-avatar" onerror="this.style.display='none'">
            <div class="member-info"><strong><%= p.display_name %></strong></div>
            <% if (p.user_id === game.created_by) { %><span class="badge">Host</span><% } %>
          </div>
        <% }) %>
      </div>

      <% if (!myPlayer) { %>
        <form action="/games/animequotes/<%= game.id %>/join" method="POST">
          <button type="submit" class="btn btn-primary">Join Game</button>
        </form>
      <% } else if (user.id === game.created_by) { %>
        <p class="text-sm" style="margin-bottom:0.75rem">
          <%= players.length %> player<%= players.length !== 1 ? 's' : '' %> →
          quote will be ~<%= [8,10,12,14,16,18,20][Math.min(players.length-1,6)] %> words
        </p>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap">
          <form action="/games/animequotes/<%= game.id %>/start" method="POST" id="start-form">
            <button type="submit" class="btn btn-primary" id="start-btn">Generate &amp; Start</button>
          </form>
          <form action="/games/animequotes/<%= game.id %>/cancel" method="POST">
            <button type="submit" class="btn btn-danger">Close Lobby</button>
          </form>
        </div>
        <script>
          document.getElementById('start-form').addEventListener('submit', function() {
            document.getElementById('start-btn').disabled = true;
            document.getElementById('aq-loading').style.display = 'flex';
            var msgs = [
              'Asking the anime gods…',
              'Consulting ancient scrolls…',
              'Summoning the perfect quote…',
              'Channeling <%= game.anime_name %>…',
              'This takes a moment, hang tight…',
              'Almost there…',
            ];
            var i = 0;
            setInterval(function() {
              i = (i + 1) % msgs.length;
              document.getElementById('aq-loading-msg').textContent = msgs[i];
            }, 2500);
          });
        </script>
      <% } else { %>
        <p class="text-sm">Waiting for the host to start...</p>
      <% } %>
    </section>

  <%# ── ACTIVE / COMPLETED ────────────────────────── %>
  <% } else { %>

    <%# Progress bar %>
    <div class="aq-progress">
      <span class="text-sm"><%= totalSolved %>/<%= totalGuessable %> words solved</span>
      <div class="aq-progress-bar">
        <div class="aq-progress-fill" style="width:<%= totalGuessable > 0 ? Math.round(totalSolved/totalGuessable*100) : 0 %>%"></div>
      </div>
    </div>

    <%# Quote layout %>
    <div class="aq-quote-layout" id="quote-layout" data-status="<%= game.status %>">
      <% quoteWords.forEach(function(w) { %>
        <% if (w.is_given || w.solved || w.revealed) { %>
          <span class="aq-word <%= w.solved ? 'aq-word--solved' : (w.revealed ? 'aq-word--revealed' : 'aq-word--given') %>">
            <%= w.word %>
          </span>
        <% } else { %>
          <button class="aq-word aq-word--unsolved <%= activeWord && activeWord.id === w.id ? 'aq-word--active' : '' %>"
            data-word-id="<%= w.id %>"
            onclick="window.location.href='?w=<%= w.id %>'">
            <% for (var k = 0; k < w.word_length; k++) { %><span class="aq-blank"></span><% } %>
          </button>
        <% } %>
      <% }) %>
    </div>

    <% if (game.status === 'completed') { %>
      <div class="aq-attribution" style="text-align:center;margin:1.5rem 0">
        <div class="result-message win" style="margin-bottom:1rem">Quote complete!</div>
        <% if (game.quote_raw) { %>
          <blockquote class="aq-full-quote">"<%= game.quote_raw %>"</blockquote>
        <% } %>
        <p class="aq-attribution-line">
          <% if (game.character_name) { %><strong><%= game.character_name %></strong><% } %>
          <% if (game.episode) { %><span class="text-dim"> &mdash; <%= game.episode %></span><% } %>
          <% if (game.quote_timestamp) { %><span class="text-dim"> (<%= game.quote_timestamp %>)</span><% } %>
          <span class="text-dim"> &mdash; <%= game.anime_name %></span>
        </p>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;margin-bottom:2rem">
        <a href="/games/animequotes/new" class="btn btn-primary">New Game</a>
        <a href="/games" class="btn">Games</a>
      </div>
    <% } %>

    <%# Active word board %>
    <% if (activeWord && game.status === 'active') { %>
      <div class="aq-board-section">
        <h2 style="font-family:var(--font-body);font-size:0.7rem;text-transform:uppercase;letter-spacing:.14em;color:var(--text-dim);margin-bottom:.75rem">
          Guessing word <%= activeWord.word_index + 1 %> &nbsp;·&nbsp; <%= activeWord.word_length %> letters
          &nbsp;·&nbsp; <%= activeGuesses.length %>/<%= maxGuesses %> guesses used
        </h2>

        <div class="board" id="aq-board" style="--wl:<%= activeWord.word_length %>">
          <% activeGuesses.forEach(function(g) { %>
            <div class="row" data-filled="1">
              <% g.result.forEach(function(r) { %>
                <div class="tile tile-<%= r.status %>"><%= r.letter %></div>
              <% }) %>
            </div>
          <% }) %>
          <% if (!activeWord.solved && !activeWord.revealed) { %>
            <% for (var i = activeGuesses.length; i < maxGuesses; i++) { %>
              <div class="row">
                <% for (var j = 0; j < activeWord.word_length; j++) { %>
                  <div class="tile tile-empty"></div>
                <% } %>
              </div>
            <% } %>
          <% } %>
        </div>

        <% if (!activeWord.solved && !activeWord.revealed && activeGuesses.length < maxGuesses) { %>
          <form id="aq-guess-form" style="margin:0" data-word-id="<%= activeWord.id %>" data-game-id="<%= game.id %>">
            <input type="text" id="aq-guess-input" maxlength="<%= activeWord.word_length %>"
              autocomplete="off" spellcheck="false" inputmode="none" style="display:none">
          </form>
          <div id="aq-error" class="error-msg" style="text-align:center"></div>
          <div id="game-keyboard" data-board="aq-board" data-input="aq-guess-input" data-form="aq-guess-form"></div>
        <% } else if (activeWord.solved) { %>
          <div class="result-message win">Word solved!</div>
        <% } else { %>
          <div class="result-message fail">Out of guesses — word was <strong><%= activeWord.word %></strong></div>
        <% } %>
      </div>

    <% } %>

    <%# Players section %>
    <section class="dash-section" style="margin-top:2rem">
      <h2>Players</h2>
      <div class="player-status-list">
        <% players.forEach(function(p) { %>
          <div class="player-status-item">
            <img src="<%= p.avatar_url || '' %>" alt="" class="mini-avatar" onerror="this.style.display='none'">
            <span style="flex:1"><%= p.display_name %></span>
          </div>
        <% }) %>
      </div>
    </section>


  <% } %>

</div>

<div id="aq-loading" style="display:none;position:fixed;inset:0;background:var(--bg);z-index:9999;flex-direction:column;align-items:center;justify-content:center;gap:2rem">
  <div class="aq-loader-ring"></div>
  <div style="text-align:center">
    <p style="font-family:var(--font-display);font-size:1.4rem;letter-spacing:.12em;margin:0 0 0.6rem"><%= game.anime_name.toUpperCase() %></p>
    <p style="font-family:var(--font-display);font-size:0.75rem;letter-spacing:.2em;color:var(--text-dim);margin:0" id="aq-loading-msg">Asking the anime gods…</p>
  </div>
</div>

<% if (game.status === 'active') { %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var GAME_ID        = '<%= game.id %>';
  var MY_UID         = '<%= user.id %>';
  var ACTIVE_WORD_ID = '<%= activeWord ? activeWord.id : "" %>';

  // ── GAME STATE UPDATES ──────────────────────────────────────
  var aqLayout = document.getElementById('quote-layout');
  window.wsJoin('animequotes', GAME_ID, function(data) {
    if (data.type === 'aq-key') {
      // Co-op: apply another player's keystroke to our shared input
      if (String(data.userId) !== MY_UID && String(data.wordId) === ACTIVE_WORD_ID) {
        applyKey(data.key);
      }
      return;
    }
    if (!data.words) return;
    if (data.status === 'completed') { window.location.reload(); return; }
    if (!aqLayout) return;
    data.words.forEach(function(w) {
      var btn = aqLayout.querySelector('[data-word-id="' + w.id + '"]');
      if (!btn) return;
      if (w.solved && !btn.classList.contains('aq-word--solved')) {
        btn.className = 'aq-word aq-word--solved'; btn.textContent = w.word;
      } else if (w.revealed && !btn.classList.contains('aq-word--revealed')) {
        btn.className = 'aq-word aq-word--revealed'; btn.textContent = w.word;
      }
    });
    var totalGuessable = data.words.filter(function(w) { return !w.is_given; }).length;
    var totalSolved    = data.words.filter(function(w) { return w.solved; }).length;
    var fill = document.querySelector('.aq-progress-fill');
    var lbl  = document.querySelector('.aq-progress .text-sm');
    if (fill) fill.style.width = (totalGuessable > 0 ? Math.round(totalSolved / totalGuessable * 100) : 0) + '%';
    if (lbl)  lbl.textContent  = totalSolved + '/' + totalGuessable + ' words solved';
  });

  // ── CO-OP KEY RELAY ─────────────────────────────────────────
  // Intercept virtual keyboard clicks and relay the key to all players
  var kb = document.getElementById('game-keyboard');
  if (kb) {
    kb.addEventListener('click', function(e) {
      var btn = e.target.closest('.key');
      if (!btn || !ACTIVE_WORD_ID) return;
      var txt = btn.textContent.trim();
      var key = txt === '⌫' ? 'BACKSPACE' : txt;
      if (key !== 'Enter') relayKey(key);
    });
  }
  // Physical keyboard
  document.addEventListener('keydown', function(e) {
    if (e.ctrlKey || e.altKey || e.metaKey || !ACTIVE_WORD_ID) return;
    var key = e.key.toUpperCase();
    if (key === 'BACKSPACE' || (key.length === 1 && /[A-Z]/.test(key))) relayKey(key);
  });

  function relayKey(key) {
    if (!window.wsRelay) return;
    window.wsRelay({ type: 'aq-key', userId: MY_UID, wordId: ACTIVE_WORD_ID, key: key });
  }

  // Apply a relayed key from another player to our local shared input + board
  function applyKey(key) {
    var inp = document.getElementById('aq-guess-input');
    if (!inp) return;
    var maxLen = parseInt(inp.getAttribute('maxlength'), 10) || 5;
    if (key === 'BACKSPACE') {
      inp.value = inp.value.slice(0, -1);
    } else if (key.length === 1 && /[A-Z]/.test(key) && inp.value.length < maxLen) {
      inp.value += key;
    }
    syncActiveRow(inp);
  }

  // Mirror what the keyboard IIFE does in syncActiveTiles
  function syncActiveRow(inp) {
    var boardId = kb && kb.getAttribute('data-board');
    var board   = boardId && document.getElementById(boardId);
    if (!board) return;
    var row   = board.querySelector('.row:not([data-filled])');
    if (!row) return;
    var tiles = row.querySelectorAll('.tile');
    var val   = inp.value;
    tiles.forEach(function(tile, i) {
      tile.textContent = i < val.length ? val[i] : '';
      tile.className   = i < val.length ? 'tile tile-active' : 'tile tile-empty';
    });
  }
});
</script>
<% } %>

<%- include('footer') %>
