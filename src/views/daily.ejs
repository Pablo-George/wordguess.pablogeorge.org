<%- include('header') %>
<div class="daily-page">
  <h1>Daily WordGuess</h1>
  <p class="puzzle-date"><%= puzzleDate %></p>

  <div class="board" id="board" data-max-guesses="<%= maxGuesses %>" data-word-length="<%= wordLength %>" style="--wl:<%= wordLength %>">
    <% if (guesses.length > 0) { %>
      <% guesses.forEach(function(g) { %>
        <div class="row" data-filled="1">
          <% g.result.forEach(function(r) { %>
            <div class="tile tile-<%= r.status %>"><%= r.letter %></div>
          <% }) %>
        </div>
      <% }) %>
    <% } %>
    <% if (!solved && guesses.length < maxGuesses) { %>
      <% for (let i = guesses.length; i < maxGuesses; i++) { %>
        <div class="row">
          <% for (let j = 0; j < wordLength; j++) { %>
            <div class="tile tile-empty"></div>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </div>

  <% if (solved) { %>
    <div class="result-message win">
      Solved in <%= attempt.guesses_count %> guesses! +<%= attempt.score %> pts
    </div>
  <% } else if (guesses.length >= maxGuesses) { %>
    <div class="result-message fail">
      Out of guesses! The word was "<%= answer %>"
    </div>
  <% } else { %>
    <form id="guess-form" style="margin:0">
      <input type="text" id="guess-input" maxlength="<%= wordLength %>" autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="none" style="display:none">
    </form>
    <div id="error-msg" class="error-msg"></div>
    <div id="game-keyboard" data-board="board" data-input="guess-input" data-form="guess-form"></div>
  <% } %>
</div>

<% if (leaderboard && leaderboard.length > 0) { %>
<section class="dash-section" style="margin-top:2rem;text-align:left">
  <h2>Friends Today</h2>
  <% if (!userDone) { %><p class="text-sm" style="margin-bottom:0.75rem">Finish today's puzzle to see your friends' guesses</p><% } %>
  <div class="friend-leaderboard">
    <% leaderboard.forEach(function(p, i) { %>
      <div class="friend-lb-entry">
        <div class="friend-lb-header">
          <span class="stat-rank">#<%= i + 1 %></span>
          <img src="<%= p.avatar_url || '' %>" alt="" class="mini-avatar" onerror="this.style.display='none'">
          <span class="friend-lb-name"><%= p.display_name %><% if (p.id === user.id) { %> <span class="text-sm">(you)</span><% } %></span>
          <% if (p.solved) { %>
            <span class="badge winner"><%= p.guesses_count %>/<%= 6 %></span>
          <% } else if (p.guesses_count >= 6) { %>
            <span class="badge dead">Failed</span>
          <% } else { %>
            <span class="text-sm" style="color:var(--text-dim)">Playing…</span>
          <% } %>
        </div>
        <% if (p.entryGuesses && p.entryGuesses.length > 0) { %>
          <div class="friend-board">
            <% p.entryGuesses.forEach(function(row) { %>
              <div class="friend-board-row">
                <% row.forEach(function(r) { %>
                  <div class="friend-tile friend-tile-<%= r.status %>"></div>
                <% }) %>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<%- include('footer') %>
