<%- include('header') %>
<div class="games-lobby">
  <h1>Games</h1>

  <section class="dash-section">
    <h2>Friend Lobbies</h2>
    <div id="lobbies-list">
      <% if (openLobbies.length === 0) { %>
        <p class="empty">No open lobbies from friends right now</p>
      <% } else { %>
        <% var typeNames = { pokemon: 'Pokémon Name', knockout: 'Knockout', animequotes: 'Anime Quote' }; %>
        <% var joinUrls = { pokemon: '/games/pokemon/', knockout: '/games/knockout/', animequotes: '/games/animequotes/' }; %>
        <% openLobbies.forEach(function(g) { %>
          <div class="dash-card">
            <div style="display:flex;align-items:center;gap:0.6rem;flex:1">
              <img src="<%= g.host_avatar || '' %>" alt="" class="mini-avatar" onerror="this.style.display='none'">
              <div>
                <strong><%= g.host_name %>'s <%= typeNames[g.type] %></strong>
                <% if (g.subtitle) { %><span class="text-sm" style="display:block"><%= g.subtitle %></span><% } %>
                <span class="text-sm"><%= g.player_count %> player<%= g.player_count !== 1 ? 's' : '' %> in lobby</span>
              </div>
            </div>
            <a href="<%= joinUrls[g.type] %><%= g.id %>" class="btn btn-primary btn-sm">Join</a>
          </div>
        <% }) %>
      <% } %>
    </div>
  </section>

  <section class="dash-section">
    <h2>Game Modes</h2>
    <div class="game-mode-grid">

      <div class="game-mode-card">
        <div class="game-mode-label">Solo · Unlimited</div>
        <h3>Classic</h3>
        <p class="text-sm">Standard Wordle — 6 guesses to find the word. Keep playing as many games as you want.</p>
        <a href="/classic" class="btn btn-primary" style="margin-top:auto">Play</a>
      </div>

      <div class="game-mode-card">
        <div class="game-mode-label">Gen 1</div>
        <h3>Pokémon Name</h3>
        <p class="text-sm">Guess the mystery Pokémon. The Pokémon chosen depends on how many players join — so recruit wisely.</p>
        <form action="/games/pokemon" method="POST" style="margin-top:auto">
          <button type="submit" class="btn btn-primary">Create Game</button>
        </form>
      </div>

      <div class="game-mode-card">
        <div class="game-mode-label">AI · Solo or Group</div>
        <h3>Anime Quote</h3>
        <p class="text-sm">Gemini generates a quote from your chosen anime. Guess each word Wordle-style. More players = longer quote.</p>
        <a href="/games/animequotes/new" class="btn btn-primary" style="margin-top:auto">Choose Anime</a>
      </div>

      <div class="game-mode-card">
        <div class="game-mode-label">Elimination</div>
        <h3>Knockout</h3>
        <p class="text-sm">Back-to-back Wordles. 3 minutes per round. Lowest scorer each round is eliminated. Last one standing wins.</p>
        <form action="/games/knockout" method="POST" style="margin-top:auto">
          <button type="submit" class="btn btn-primary">Create Game</button>
        </form>
      </div>

    </div>
  </section>

  <% if (myGames && myGames.length > 0) { %>
  <section class="dash-section">
    <h2>My Active Games</h2>
    <% myGames.forEach(function(g) { %>
      <div class="dash-card">
        <strong>Pokémon Game <span class="text-sm">#<%= g.id %></span></strong>
        <span class="text-sm"><%= g.player_count %> player<%= g.player_count !== 1 ? 's' : '' %> • <%= g.status %></span>
        <a href="/games/pokemon/<%= g.id %>" class="btn btn-sm">Resume</a>
      </div>
    <% }) %>
  </section>
  <% } %>
</div>

<script>
  var typeNames = { pokemon: 'Pokémon Name', knockout: 'Knockout', animequotes: 'Anime Quote' };
  var joinUrls  = { pokemon: '/games/pokemon/', knockout: '/games/knockout/', animequotes: '/games/animequotes/' };
  var knownIds  = '<%= openLobbies.map(function(g){return g.type+g.id}).join(",") %>';

  function renderLobbies(lobbies) {
    var el = document.getElementById('lobbies-list');
    if (!lobbies.length) {
      el.innerHTML = '<p class="empty">No open lobbies from friends right now</p>';
      return;
    }
    el.innerHTML = lobbies.map(function(g) {
      return '<div class="dash-card">' +
        '<div style="display:flex;align-items:center;gap:0.6rem;flex:1">' +
          '<img src="' + (g.host_avatar || '') + '" alt="" class="mini-avatar" onerror="this.style.display=\'none\'">' +
          '<div>' +
            '<strong>' + g.host_name + '\'s ' + (typeNames[g.type] || g.type) + '</strong>' +
            (g.subtitle ? '<span class="text-sm" style="display:block">' + g.subtitle + '</span>' : '') +
            '<span class="text-sm">' + g.player_count + ' player' + (g.player_count !== 1 ? 's' : '') + ' in lobby</span>' +
          '</div>' +
        '</div>' +
        '<a href="' + joinUrls[g.type] + g.id + '" class="btn btn-primary btn-sm">Join</a>' +
      '</div>';
    }).join('');
  }

  setInterval(function() {
    if (document.hidden) return;
    fetch('/games/lobbies')
      .then(function(r) { return r.json(); })
      .then(function(lobbies) {
        var newIds = lobbies.map(function(g) { return g.type + g.id; }).join(',');
        if (newIds !== knownIds) {
          knownIds = newIds;
          renderLobbies(lobbies);
        }
      })
      .catch(function() {});
  }, 5000);
</script>
<%- include('footer') %>
