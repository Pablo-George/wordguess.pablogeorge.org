<%- include('header') %>
<div class="groups-page">
  <h1>Your Groups</h1>
  <a href="/groups/new" class="btn btn-primary">Create Group</a>

  <% if (groups.length === 0) { %>
    <p class="empty">No groups yet. Create one to start competing!</p>
  <% } %>

  <div class="group-list">
    <% groups.forEach(function(g) { %>
      <div class="group-card">
        <h3><%= g.name %></h3>
        <p class="text-sm"><%= g.member_count %> members</p>
        <a href="/groups/<%= g.id %>" class="btn btn-sm">View</a>
      </div>
    <% }) %>
  </div>
</div>
<%- include('footer') %>
