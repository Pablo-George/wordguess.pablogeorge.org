<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WordGuess - <%= typeof title !== 'undefined' ? title : 'Play' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:ital,wght@0,300;0,400;0,500;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-inner">
      <a href="/" class="nav-logo">WORDGUESS</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="nav-links" id="nav-links">
          <a href="/daily">Daily</a>
          <a href="/friends">Friends</a>
          <a href="/groups">Groups</a>
          <a href="/battles/new">Battle</a>
          <a href="/royale/new">Royale</a>
          <a href="/logout" class="nav-logout-link">Logout</a>
        </div>
        <div class="nav-user">
          <% if (user.avatar_url) { %><img src="<%= user.avatar_url %>" alt="" class="nav-avatar"><% } %>
          <span class="nav-name"><%= user.display_name %></span>
          <a href="/logout" class="nav-logout">Logout</a>
          <button class="nav-burger" id="nav-burger" aria-label="Toggle menu" aria-expanded="false">
            <span></span><span></span><span></span>
          </button>
        </div>
      <% } %>
    </div>
  </nav>
  <main class="container">
