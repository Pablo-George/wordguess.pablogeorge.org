<%- include('header') %>
<div class="dashboard">
  <h1>Dashboard</h1>

  <section class="dash-section">
    <h2>Today's Puzzle</h2>
    <div class="dash-card">
      <% if (todayAttempt && todayAttempt.solved) { %>
        <p>Solved in <%= todayAttempt.guesses_count %> guesses! <strong>+<%= todayAttempt.score %> pts</strong></p>
        <a href="/daily" class="btn btn-sm">View</a>
      <% } else if (todayAttempt && !todayAttempt.solved && todayAttempt.guesses_count >= 6) { %>
        <p>Failed today's puzzle. Better luck tomorrow!</p>
        <a href="/daily" class="btn btn-sm">View</a>
      <% } else { %>
        <p>Today's word is ready. Can you solve it?</p>
        <a href="/daily" class="btn btn-primary">Play</a>
      <% } %>
    </div>
  </section>

  <section class="dash-section">
    <h2>Active Pokémon Games</h2>
    <% if (activeGames.length === 0) { %>
      <p class="empty">No active games — <a href="/games">start one</a></p>
    <% } %>
    <% activeGames.forEach(function(g) { %>
      <div class="dash-card">
        <strong>Game #<%= g.id %></strong>
        <span class="text-sm"><%= g.player_count %> player<%= g.player_count !== 1 ? 's' : '' %> • <%= g.status %></span>
        <a href="/games/pokemon/<%= g.id %>" class="btn btn-sm">Resume</a>
      </div>
    <% }) %>
    <a href="/games" class="btn btn-sm" style="margin-top:0.5rem">Browse Games</a>
  </section>
</div>
<%- include('footer') %>
