<%- include('header') %>
<div class="session-page">
  <h1><%= session.name %></h1>
  <p class="text-sm"><%= session.start_date %> to <%= session.end_date %></p>
  <p class="text-sm">Group: <%= session.group_name %> | Mode: <%= session.scoring_mode %></p>

  <h2>Leaderboard</h2>
  <% if (leaderboard.length === 0) { %>
    <p class="empty">No data yet</p>
  <% } else { %>
    <table class="leaderboard">
      <thead>
        <tr>
          <th>#</th>
          <th>Player</th>
          <th>Points</th>
          <th>Solved</th>
          <th>Avg Guesses</th>
        </tr>
      </thead>
      <tbody>
        <% leaderboard.forEach(function(p, i) { %>
          <tr class="<%= p.id === user.id ? 'highlight' : '' %>">
            <td><%= i + 1 %></td>
            <td class="player-cell">
              <img src="<%= p.avatar_url || '' %>" alt="" class="mini-avatar" onerror="this.style.display='none'">
              <%= p.display_name %>
            </td>
            <td><strong><%= p.total_points %></strong></td>
            <td><%= p.words_solved %></td>
            <td><%= p.avg_guesses ? p.avg_guesses : '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<%- include('footer') %>
